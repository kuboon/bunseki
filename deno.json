{
  "workspace": [
    "./client",
    "./kvAdmin",
    "./otlp",
    "./server"
  ],
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno test -P --allow-read=.,$(deno info --json | jq -r .denoDir)",
    "build": "deno task --cwd=client build",
    "dev": "deno task --cwd=server dev",
    "serve": "deno serve --allow-read=./client/_site server/serve.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.10.8",
    "@hono/standard-validator": "jsr:@hono/standard-validator@^0.2.0",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@std/fs": "jsr:@std/fs@^1.0.18",
    "@std/path": "jsr:@std/path@^1.0.8",
    "arktype": "npm:arktype@^2.1.28",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.14/jsx-runtime.ts"
  },
  "unstable": [
    "bundle",
    "fmt-component",
    "temporal",
    "kv"
  ],
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "proseWrap": "preserve"
  },
  "test": {
    "permissions": {
      "read": [
        "./client/_site"
      ]
    }
  },
  "deploy": {
    "org": "kuboon-tokyo",
    "app": "bunseki"
  }
}
